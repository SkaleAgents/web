# Railway Variables for the web service.
# NEXT_PUBLIC_* are baked at build time — redeploy after changing them.

NEXT_PUBLIC_API_URL=https://REPLACE_API_HOST.up.railway.app
NEXT_PUBLIC_APP_URL=https://REPLACE_WEB_HOST.up.railway.app

# Comma-separated hostnames without scheme
APP_HOSTS=REPLACE_WEB_HOST.up.railway.app
MARKETING_HOSTS=REPLACE_WEB_HOST.up.railway.app
