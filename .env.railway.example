# Railway Variables for the web service.
# NEXT_PUBLIC_* are baked at build time — redeploy after changing them.

NEXT_PUBLIC_API_URL=https://REPLACE_API_HOST.up.railway.app
NEXT_PUBLIC_MOCK_AUTH_ENABLED=false
NEXT_PUBLIC_ADVISORY_AGREEMENTS_ENABLED=false
NEXT_PUBLIC_ADVISORY_DELIVERY_HANDOFFS_ENABLED=false
# Temporary public preview warning; set false for the production launch.
NEXT_PUBLIC_SHOW_DEV_WARNING=true
